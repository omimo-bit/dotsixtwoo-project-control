function doGet(){return json_({success:true,data:{service:'DOTSIXTWOO API',version:'1.0.0'}})}
function doPost(e){try{var req=JSON.parse((e.postData&&e.postData.contents)||'{}');var action=req.action||'';var payload=req.payload||{};var token=req.token||'';var publicActions=['authenticateUser'];var user=null;if(publicActions.indexOf(action)===-1) user=requireSession_(token);var routes={authenticateUser:function(){return authenticateUser(payload)},getCurrentUser:function(){return user},logout:function(){return logout_(token)},getDashboard:function(){return getDashboard_(user)},getProjects:function(){return listRows_('PROJECTS')},getProject:function(){return getById_('PROJECTS','projectId',payload.projectId)},createProject:function(){return createProject_(payload,user)},updateProject:function(){return updateEntity_('PROJECTS','projectId',payload,user)},getTasks:function(){return listRows_('TASKS')},getMyTasks:function(){return listRows_('TASKS').filter(function(x){return String(x.picEmail||'').toLowerCase()===String(user.email).toLowerCase()||String(x.pic||'').toLowerCase()===String(user.name).toLowerCase()})},createTask:function(){return createTask_(payload,user)},updateTask:function(){return updateEntity_('TASKS','taskId',payload,user)},getMeetings:function(){return listRows_('MEETINGS')},createMeeting:function(){return createMeeting_(payload,user)},updateMeeting:function(){return updateEntity_('MEETINGS','meetingId',payload,user)},createMOM:function(){return createMOM_(payload,user)},updateMOM:function(){return updateEntity_('MOM','momId',payload,user)},createTaskFromMOM:function(){return createTaskFromMOM_(payload,user)},getBudget:function(){return getBudget_()},updateBudget:function(){return updateBudget_(payload,user)},getDocuments:function(){return listRows_('DOCUMENTS')},createDocument:function(){return createEntity_('DOCUMENTS','documentId','DOC',payload,user)},getActivityLog:function(){return listRows_('ACTIVITY_LOG').reverse()},getNotifications:function(){return listRows_('NOTIFICATIONS').filter(function(x){return x.userId===user.userId&&!x.readAt})},markNotificationRead:function(){return updateEntity_('NOTIFICATIONS','notificationId',{notificationId:payload.notificationId,readAt:new Date()},user)},createDailyUpdate:function(){return createEntity_('DAILY_UPDATES','updateId','U',payload,user)}};if(!routes[action]) throw new Error('Unknown action: '+action);return json_({success:true,data:routes[action]()})}catch(err){return json_({success:false,error:String(err.message||err)})}}
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
