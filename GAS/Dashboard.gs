function getDashboard_(user){var projects=listRows_('PROJECTS'),tasks=listRows_('TASKS'),meetings=listRows_('MEETINGS'),mine=tasks.filter(function(t){return String(t.picEmail||'').toLowerCase()===String(user.email).toLowerCase()||String(t.pic||'').toLowerCase()===String(user.name).toLowerCase()}),today=new Date();today.setHours(0,0,0,0);return{totalProjects:projects.length,myTasks:mine.filter(function(t){return t.status!=='Completed'}).length,overdueTasks:mine.filter(function(t){var d=t.deadline?new Date(t.deadline):null;return d&&d<today&&t.status!=='Completed'}).length,momPending:meetings.filter(function(m){return m.momStatus==='Pending'}).length}}
