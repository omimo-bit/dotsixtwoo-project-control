function createMOM_(p,user){if(!p.meetingId)throw new Error('Meeting ID wajib');var existing=listRows_('MOM').find(function(x){return String(x.meetingId)===String(p.meetingId)});if(existing)throw new Error('MOM untuk meeting ini sudah ada');var mt=getById_('MEETINGS','meetingId',p.meetingId);if(mt){p.projectId=mt.projectId;p.projectName=mt.projectName;p.meetingDate=mt.date;p.participants=p.participants||mt.participants}var mom=createEntity_('MOM','momId','MOM',p,user);updateEntity_('MEETINGS','meetingId',{meetingId:p.meetingId,momStatus:'Done',status:'Completed'},user);return mom}
function getMOMByMeeting_(meetingId){return listRows_('MOM').find(function(x){return String(x.meetingId)===String(meetingId)})||null}
function createTaskFromMOM_(p,user){var mom=getById_('MOM','momId',p.momId);if(!mom)throw new Error('MOM not found');if(!p.actionItem||!p.pic)throw new Error('Action dan PIC wajib');var action=createEntity_('MOM_ACTIONS','actionId','MA',{momId:p.momId,projectId:mom.projectId,actionItem:p.actionItem,pic:p.pic,deadline:p.deadline,status:'OPEN'},user);var task=createTask_({projectId:mom.projectId,projectName:mom.projectName,taskName:p.actionItem,pic:p.pic,deadline:p.deadline,status:'Not Started',priority:p.priority||'Medium',momId:p.momId},user);updateEntity_('MOM_ACTIONS','actionId',{actionId:action.actionId,taskId:task.taskId},user);return task}
