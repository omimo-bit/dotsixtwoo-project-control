function createMOM_(p,user){if(!p.meetingId)throw new Error('Meeting ID wajib');var mt=getById_('MEETINGS','meetingId',p.meetingId);if(mt){p.projectId=mt.projectId;p.projectName=mt.projectName;p.meetingDate=mt.date;p.participants=p.participants||mt.participants}var mom=createEntity_('MOM','momId','MOM',p,user);updateEntity_('MEETINGS','meetingId',{meetingId:p.meetingId,momStatus:'Done'},user);return mom}
function createTaskFromMOM_(p,user){var mom=getById_('MOM','momId',p.momId);if(!mom)throw new Error('MOM not found');return createTask_({projectId:mom.projectId,projectName:mom.projectName,taskName:p.actionItem,pic:p.pic,deadline:p.deadline,status:'Not Started',priority:p.priority||'Medium',momId:p.momId},user)}
