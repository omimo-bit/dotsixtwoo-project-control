function hash_(password,salt){var bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,password+salt,Utilities.Charset.UTF_8);return bytes.map(function(b){var x=(b<0?b+256:b).toString(16);return x.length===1?'0'+x:x}).join('')}
function seedAdmin_(){if(listRows_('USERS').length)return;var salt=Utilities.getUuid();append_('USERS',{userId:'USR-ADMIN',name:'MIMO',email:'CHANGE_ME@example.com',passwordHash:hash_('ChangeMe123!',salt),salt:salt,role:'PM',active:true,createdAt:new Date(),updatedAt:new Date()})}
function authenticateUser(p){var email=String(p.email||'').toLowerCase(),users=listRows_('USERS');var u=users.find(function(x){return String(x.email).toLowerCase()===email&&String(x.active)!=='false'});if(!u||hash_(String(p.password||''),u.salt)!==u.passwordHash)throw new Error('Email atau password salah');var token=Utilities.getUuid()+Utilities.getUuid();PropertiesService.getScriptProperties().setProperty('SESSION_'+token,JSON.stringify({userId:u.userId,expires:Date.now()+APP.SESSION_HOURS*3600000}));log_(u,'LOGIN','AUTH',u.userId,'User login');return{token:token,user:safeUser_(u)}}
function requireSession_(token){var raw=PropertiesService.getScriptProperties().getProperty('SESSION_'+token);if(!raw)throw new Error('Session expired');var s=JSON.parse(raw);if(Date.now()>s.expires){PropertiesService.getScriptProperties().deleteProperty('SESSION_'+token);throw new Error('Session expired')}var u=getById_('USERS','userId',s.userId);if(!u)throw new Error('User not found');return safeUser_(u)}
function safeUser_(u){return{userId:u.userId,name:u.name,email:u.email,role:u.role,phone:u.phone}}
function logout_(token){PropertiesService.getScriptProperties().deleteProperty('SESSION_'+token);return true}
