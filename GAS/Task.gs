function createTask_(p,user){if(!p.projectId||!p.taskName||!p.pic)throw new Error('Project, task, PIC wajib');var project=getById_('PROJECTS','projectId',p.projectId);if(project)p.projectName=project.projectName;p.progress=Number(p.progress||0);var users=listRows_('USERS');var pic=users.find(function(x){return String(x.name).toLowerCase()===String(p.pic).toLowerCase()});if(pic)p.picEmail=pic.email;return createEntity_('TASKS','taskId','T',p,user)}
