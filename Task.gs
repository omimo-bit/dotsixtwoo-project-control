function createTask_(p,user){if(!p.projectId||!p.taskName||!p.pic)throw new Error('Project, task, PIC wajib');var project=getById_('PROJECTS','projectId',p.projectId);if(project)p.projectName=project.projectName;p.progress=Math.max(0,Math.min(100,Number(p.progress||0)));p.status=p.status||'Not Started';p.priority=p.priority||'Medium';var users=listRows_('USERS');var pic=users.find(function(x){return String(x.name).toLowerCase()===String(p.pic).toLowerCase()});if(pic)p.picEmail=pic.email;var t=createEntity_('TASKS','taskId','T',p,user);if(pic)notify_(pic.userId,'TASK_ASSIGNED','Task baru: '+p.taskName,(project?project.projectName:p.projectId)+' · Deadline '+(p.deadline||'-'),t.taskId);return t}
function updateTask_(p,user){var old=getById_('TASKS','taskId',p.taskId);if(!old)throw new Error('Task tidak ditemukan');var mine=String(old.picEmail||'').toLowerCase()===String(user.email).toLowerCase()||String(old.pic||'').toLowerCase()===String(user.name).toLowerCase();if(!mine&&!isManager_(user))throw new Error('Anda hanya dapat mengupdate task milik sendiri');if(p.progress!==undefined)p.progress=Math.max(0,Math.min(100,Number(p.progress||0)));if(p.pic){var pic=listRows_('USERS').find(function(x){return String(x.name).toLowerCase()===String(p.pic).toLowerCase()});if(pic)p.picEmail=pic.email}var result=updateEntity_('TASKS','taskId',p,user);if(result.status==='Blocked'){var managers=listRows_('USERS').filter(function(x){return isManager_(x)});managers.forEach(function(m){notify_(m.userId,'TASK_BLOCKED','Task blocked: '+result.taskName,result.projectName+' · PIC '+result.pic,result.taskId)})}return result}
